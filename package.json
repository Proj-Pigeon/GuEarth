{
  "name": "guearth",
  "version": "0.1.15",
  "private": true,
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm run fetch:ffmpeg && npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    },
    "katex": "^0.18.2"
  },
  "devDependencies": {
    "@sentry/electron": "^8.0.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "ant-design-vue": "^4.2.6",
    "ant-design-x-vue": "^1.6.0",
    "antd": "6.6.5",
    "cesium": "^1.145.0",
    "echarts": "^6.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "markdown-it": "^15.0.3",
    "mp4-muxer": "^5.2.2",
    "pinia": "^4.0.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
}
